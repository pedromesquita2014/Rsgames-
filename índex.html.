async function resolveNames(){
if(!S.user)return;
try{var ids={};S.posts.forEach(function(p){if(p.authorId)ids[p.authorId]=1;});Object.keys(S.profiles).forEach(function(i){ids[i]=1;});if(S.uid)ids[S.uid]=1;
var list=Object.keys(ids);if(!list.length)return;var ps=await S.user.profiles(list),ch=false;
list.forEach(function(id){var n=(ps[id]&&ps[id].name)||'';if(S.names[id]!==n){S.names[id]=n;ch=true;}});if(ch)render();}catch(e){}}
function subscribe(){
var slow=setTimeout(function(){if(!S.postsReady){S.postsErr='lento';render();}},10000);
S.db.collection('posts').orderBy('createdAt','desc').limit(100).onSnapshot(function(snap){
clearTimeout(slow);S.postsReady=true;S.postsErr='';
S.posts=snap.docs.map(function(d){return Object.assign({id:d.id},d.data());}).filter(function(p){return (p.type==='game'||p.type==='video')&&typeof p.title==='string';});
S.posts.forEach(function(p){if(p.authorName&&p.authorId&&!S.pn[p.authorId])S.pn[p.authorId]=String(p.authorName).slice(0,40);});
render();resolveNames();},function(err){clearTimeout(slow);S.postsReady=true;S.postsErr=(err&&err.code)||'erro';render();});
S.db.collection('likes').onSnapshot(function(snap){var m=new Map();
snap.docs.forEach(function(d){var x=d.data();if(!x||!x.postId||!x.uid)return;if(!m.has(x.postId))m.set(x.postId,new Set());m.get(x.postId).add(x.uid);});S.likes=m;render();},function(){});
S.db.collection('views').onSnapshot(function(snap){var m=new Map();snap.docs.forEach(function(d){var x=d.data();if(!x||!x.postId||!x.uid)return;if(!m.has(x.postId))m.set(x.postId,new Set());m.get(x.postId).add(x.uid);});S.views=m;render();},function(){});
S.db.collection('profiles').onSnapshot(function(snap){var m={};snap.docs.forEach(function(d){m[d.id]=d.data();});S.profiles=m;render();resolveNames();},function(){});}
