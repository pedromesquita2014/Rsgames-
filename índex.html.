if(!LANGS[c.lang]){var n=String(navigator.language||'pt').slice(0,2).toLowerCase();c.lang=LANGS[n]?n:'pt';}return c;}
S.cfg=loadCfg();
function applyCfg(){var c=S.cfg,r=document.documentElement;r.lang=LOC[c.lang];if(c.theme==='auto')r.removeAttribute('data-theme');else r.setAttribute('data-theme',c.theme);
document.body.style.fontSize={s:'13px',m:'15px',l:'17px'}[c.size]||'15px';r.classList.toggle('calm',!!c.calm);musicIcon();}
function saveCfg(){try{localStorage.setItem('rsgames.cfg',JSON.stringify(S.cfg));}catch(e){}applyCfg();}
function resetChrome(){var t=document.getElementById('tabs');t.replaceChildren();t.setAttribute('aria-label','Seções');document.getElementById('btn-post').textContent='Postar';var bm=document.getElementById('btn-mus');bm.setAttribute('aria-label','Música');bm.setAttribute('title','Música');document.querySelector('.brand').setAttribute('aria-label','rsgames, início');}
function setLang(v){if(!LANGS[v])return;S.cfg.lang=v;saveCfg();resetChrome();render();}
function sign(w){var t='rsg|'+S.uid+'|'+w.coins+'|'+w.gems+'|'+w.xp+'|'+w.streak+'|'+w.lastDaily+'|'+(w.owned||[]).join(',')+'|k9x';var a=0xdeadbeef,b=0x41c6ce57,i,c;
for(i=0;i<t.length;i++){c=t.charCodeAt(i);a=Math.imul(a^c,2654435761);b=Math.imul(b^c,1597334677);}
a=Math.imul(a^(a>>>16),2246822507)^Math.imul(b^(b>>>13),3266489909);b=Math.imul(b^(b>>>16),2246822507)^Math.imul(a^(a>>>13),3266489909);
return (4294967296*(2097151&b)+(a>>>0)).toString(36);}
function checked(d){var n=normalize(d);if(S.isOwner)return n;var legacy=!d.sig&&n.coins<=5000&&n.gems<=5;if(legacy||d.sig===sign(n))return n;toast('Dados alterados fora do site. Carteira restaurada.');return normalize(null);}
function viewsOf(id){var x=S.views.get(id);return x?x.size:0;}
function viewTotal(uid){var n=0;S.posts.forEach(function(p){if(p.authorId===uid)n+=viewsOf(p.id);});return n;}
function trackView(p){if(!S.db||!S.uid||p.authorId===S.uid)return;var x=S.views.get(p.id);if(x&&x.has(S.uid))return;try{S.db.collection('views').doc(p.id+'_'+S.uid).set({postId:p.id,uid:S.uid,t:Date.now()}).catch(function(){});}catch(e){}}


/* proteção do código dos jogos: criptografia no banco + trava de cópia na tela do jogo */
var KEYSEED='rsg·k7#Pq2·v1',CRY=!!(window.crypto&&window.crypto.subtle);
async function ckey(salt){var e=new TextEncoder(),b=await crypto.subtle.importKey('raw',e.encode(KEYSEED),'PBKDF2',false,['deriveKey']);
return crypto.subtle.deriveKey({name:'PBKDF2',salt:e.encode(String(salt)),iterations:20000,hash:'SHA-256'},b,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);}
function b64(u){var t='',i;for(i=0;i<u.length;i+=8192)t+=String.fromCharCode.apply(null,u.subarray(i,i+8192));return btoa(t);}
function unb64(t){var a=atob(t),u=new Uint8Array(a.length),i;for(i=0;i<a.length;i++)u[i]=a.charCodeAt(i);return u;}
async function encCode(text,salt){var iv=crypto.getRandomValues(new Uint8Array(12)),k=await ckey(salt),ct=new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv:iv},k,new TextEncoder().encode(text))),o=new Uint8Array(12+ct.length);o.set(iv);o.set(ct,12);return b64(o);}
async function decCode(t,salt){var u=unb64(t),k=await ckey(salt);return new TextDecoder().decode(await crypto.subtle.decrypt({name:'AES-GCM',iv:u.subarray(0,12)},k,u.subarray(12)));}
